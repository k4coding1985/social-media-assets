  "voiceover": [
    {
      "id": "hook",
      "text": "You ran git stash drop and lost your work?"
    },
    {
      "id": "bug",
      "text": "Most devs panic here."
    },
    {
      "id": "why",
      "text": "But the stash commit still exists until garbage collection."
    },
    {
      "id": "fix",
      "text": "Run git fsck unreachable, find the commit hash, then git stash apply with that hash. Your changes are back in seconds."
    },
    {
      "id": "bait",
      "text": "Stash, or a WIP commit? Comment your answer."
    },
    {
      "id": "follow",
      "text": "Follow K four coding for part six."
