 ],
 "voiceover": [
  {"id": "hook", "text": "Your loop finished before a single save happened."},
  {"id": "bug", "text": "You wrote users dot forEach with an async callback that awaits a database save, then sent the response saying done."},
  {"id": "why", "text": "forEach ignores the promises your callback returns. It starts every save and moves on, so done runs first and errors go unhandled."},
  {"id": "fix", "text": "Use a for of loop with await to save in order, or await Promise dot all to run them together and catch any failure."},
  {"id": "follow", "text": "Follow K four coding."}
