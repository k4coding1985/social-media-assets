 "voiceover": [
  {
   "id": "hook",
   "text": "Why does this log order look wrong?"
  },
  {
   "id": "bug",
   "text": "You log start, set a timeout of zero, resolve a promise, then log end. You expect timeout before promise. The console prints start, end, promise, timeout."
  },
  {
   "id": "why",
   "text": "Promise callbacks go to the microtask queue. Timers go to the task queue. After the stack empties, the event loop drains all microtasks first, then one task."
  },
  {
   "id": "fix",
   "text": "Never rely on set timeout zero for ordering. To run code after the promise, await it or chain it in then."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part two."
  }
 ],
