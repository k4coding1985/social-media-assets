 "voiceover": [
  {
   "id": "hook",
   "text": "Your Docker host disk is full, and nothing looks wrong?"
  },
  {
   "id": "bug",
   "text": "Check the container logs."
  },
  {
   "id": "why",
   "text": "The default json file driver keeps logs with no size limit. Every line your app prints stays on disk until the disk fills."
  },
  {
   "id": "fix",
   "text": "In daemon dot json, set max size ten megabytes and max file three. That caps each container near thirty megabytes. Restart Docker, then recreate your containers."
  },
  {
   "id": "bait",
   "text": "Daemon default or per app setting? Comment which one you use."
  },
  {
   "id": "follow",
   "text": "Follow me for one DevOps fix every day."
  }
