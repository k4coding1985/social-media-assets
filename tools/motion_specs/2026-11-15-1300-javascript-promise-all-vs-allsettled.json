 "voiceover": [
  {
   "id": "hook",
   "text": "One failed request wiped all your data?"
  },
  {
   "id": "bug",
   "text": "Your API loads users, orders and prices with Promise all. Users and orders succeed. Prices times out. Promise all rejects at once, and both good results are lost."
  },
  {
   "id": "why",
   "text": "Promise all fails fast. The first rejection wins, and you never get the values that did resolve."
  },
  {
   "id": "fix",
   "text": "If partial data is fine, use Promise all settled. Each result has a status, fulfilled or rejected, so you render what worked."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part three."
  }
 ],
