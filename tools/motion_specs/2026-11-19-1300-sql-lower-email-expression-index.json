 "voiceover": [
  {
   "id": "hook",
   "text": "Index exists, still slow?"
  },
  {
   "id": "bug",
   "text": "Most devs add another index here."
  },
  {
   "id": "why",
   "text": "But lower of email wraps the column, so a normal index can't match. Postgres scans every single row."
  },
  {
   "id": "fix",
   "text": "Build an expression index on lower of email. Now the same query seeks straight to the row, and the slow scan disappears."
  },
  {
   "id": "bait",
   "text": "Expression index or pg trgm? Comment which one."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part seven."
  }
