  {"id": "fix", "at": "fix:start", "text": "USE {{WITH-LEASE}}", "color": "purple"}
 ],
 "voiceover": [
  {"id": "hook", "text": "Your force push just deleted a teammate's work."},
  {"id": "bug", "text": "You rebased your branch, then ran git push force. But your teammate had pushed a new commit to the same branch a minute earlier."},
  {"id": "why", "text": "Force replaces the remote branch with your copy. Their commit is no longer on the branch, and nobody gets a warning."},
  {"id": "fix", "text": "Use force with lease instead. Git checks that the remote still matches what you last fetched. If someone pushed, it refuses, so you fetch and rebase first."},
  {"id": "follow", "text": "Follow K four coding."}
 ],
 "elements": [
  {"id": "l1", "type": "line", "from": "local.top-240", "to": "remote.bottom-240", "start_visible": true},
  {"id": "l2", "type": "line", "from": "local.top-80", "to": "remote.bottom-80", "start_visible": true},
  {"id": "l3", "type": "line", "from": "local.top+80", "to": "remote.bottom+80", "start_visible": true},
  {"id": "l4", "type": "line", "from": "local.top+240", "to": "remote.bottom+240", "start_visible": true},
