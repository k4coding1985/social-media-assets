 "voiceover": [
  {
   "id": "hook",
   "text": "Your revenue report just doubled overnight."
  },
  {
   "id": "bug",
   "text": "You join orders to payments to show total revenue. One order has two payment rows, so the join returns that order twice."
  },
  {
   "id": "why",
   "text": "SUM counts every joined row. Each extra payment copies the order amount, so the total inflates silently."
  },
  {
   "id": "fix",
   "text": "Aggregate payments first in a subquery, then join one row per order. Now each order counts once, and the total is correct."
  },
  {
   "id": "follow",
   "text": "Follow K four coding."
  }
 ],
