{
 "slug": "git-detached-head-lost-commits",
 "series": {"label": "Git Mistakes", "number": 1, "color": "orange"},
 "voice": {"name": "en-IN-NeerjaExpressiveNeural", "rate": "+5%", "pitch": "+0Hz"},
 "captions": {"enabled": true, "keywords": ["detached HEAD", "no branch", "reflog", "git log", "garbage collection", "branch"], "keyword_color": "yellow", "max_chars": 30},
 "cover_at": "why@vanish+0.5",
 "chapters": [
  {"id": "hook", "text": "COMMITS {{GONE}}?", "color": "red"},
  {"id": "bug", "at": "bug:start", "text": "{{DETACHED}} HEAD", "color": "yellow"},
  {"id": "why", "at": "why:start", "text": "{{NO}} BRANCH", "color": "red"},
  {"id": "fix", "at": "fix:start", "text": "MAKE A {{BRANCH}}", "color": "purple"}
 ],
 "voiceover": [
  {"id": "hook", "text": "Where did my commits go?"},
  {"id": "bug", "text": "You checked out an old commit, so you are in detached HEAD. You commit there, then switch back to main."},
  {"id": "why", "text": "Those commits belong to no branch. Nothing points at them, so they vanish from git log and garbage collection can delete them later."},
  {"id": "fix", "text": "Before leaving, run git switch dash c and a branch name. Already left? Find the hash with git reflog, then create a branch on it."},
  {"id": "follow", "text": "Follow K four coding for part two."}
 ],
 "elements": [
  {"id": "la", "type": "line", "from": "main.bottom", "to": "repo.top-200", "start_visible": true},
  {"id": "lb", "type": "line", "from": "head.bottom", "to": "repo.top+200", "start_visible": true},
  {"id": "main", "type": "window", "x": 290, "y": 480, "w": 480, "h": 200, "title": "MAIN", "icon": "laptop", "status": "cyan", "body": "main -> {{c3}}", "body_size": 50, "hl": "cyan", "start_visible": true},
  {"id": "head", "type": "window", "x": 790, "y": 480, "w": 480, "h": 200, "title": "HEAD", "icon": "cpu", "status": "cyan", "body": "HEAD -> {{main}}", "body_size": 50, "hl": "cyan", "start_visible": true},
  {"id": "repo", "type": "window", "x": 540, "y": 880, "w": 800, "h": 200, "title": "GIT LOG", "icon": "database", "tag": "REPO", "status": "cyan", "body": "c1 - c2 - {{c3}}", "body_size": 56, "hl": "cyan", "start_visible": true},
  {"id": "lost", "type": "counter", "x": 540, "y": 1035, "font": "mono", "weight": "Medium", "upper": false, "size": 48, "value": 0, "format": "lost commits: {n}", "color": "white", "start_visible": true},
  {"id": "code", "type": "code", "x": 540, "y": 1250, "w": 960, "min_lines": 2, "title": "terminal", "lines": ["git {{checkout}} c1", "git {{commit}} -m \"hotfix\""]},
  {"id": "stamp", "type": "badge", "kind": "stamp", "text": "NO BRANCH", "x": 540, "y": 680, "size": 44, "color": "red"},
  {"id": "ok", "type": "badge", "kind": "check", "x": 540, "y": 680, "r": 40, "color": "cyan"}
 ],
 "timeline": [
