  {"at": "why@delete", "do": "pulse", "target": "repo"},
  {"at": "fix@leaving", "do": "hide", "target": "stamp", "dur": 0.3},
  {"at": "fix@run", "do": "swap", "target": "code", "type_dur": 1.3, "lines": ["git {{switch -c}} rescue", "git {{reflog}}  # find c4"]},
  {"at": "fix@run", "do": "color", "target": ["code", "code:hl"], "color": "purple", "dur": 0.4},
  {"at": "fix@branch", "do": "swap", "target": "head", "text": "{{rescue}} -> c4"},
  {"at": "fix@branch", "do": "color", "target": ["head", "head:status", "head:hl"], "color": "purple", "dur": 0.3},
  {"at": "fix@already", "do": "send", "path": "lb", "count": 3, "interval": 0.12, "dur": 0.5, "color": "purple"},
  {"at": "fix@hash", "do": "pulse", "target": "code"},
  {"at": "fix@reflog", "do": "swap", "target": "repo", "text": "c1 - c2 - c3  {{c4}}"},
  {"at": "fix@reflog", "do": "color", "target": ["repo", "repo:status", "repo:hl"], "color": "cyan", "dur": 0.4},
  {"at": "fix@create", "do": "set", "target": "lost", "value": 0, "dur": 0.4},
