 "voiceover": [
  {
   "id": "hook",
   "text": "Your API froze because of one slow call."
  },
  {
   "id": "bug",
   "text": "Your Python code calls a payment service with requests dot get, and passes no timeout."
  },
  {
   "id": "why",
   "text": "Requests has no default timeout. If that service hangs, your worker waits forever. Every new request grabs another worker, until all workers are stuck and the whole API stops."
  },
  {
   "id": "fix",
   "text": "Always pass a timeout, like three comma ten. Three seconds to connect, ten to read. Catch the timeout error and fail fast."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part two."
  }
 ],
