 "voiceover": [
  {
   "id": "hook",
   "text": "Page ten thousand timed out?"
  },
  {
   "id": "bug",
   "text": "Most devs add more indexes here."
  },
  {
   "id": "why",
   "text": "But OFFSET scans and throws away every earlier row, so later pages get slower."
  },
  {
   "id": "fix",
   "text": "Use keyset pagination. Where id is greater than the last id, limit twenty. It seeks straight to the page, so page ten thousand loads like page one."
  },
  {
   "id": "bait",
   "text": "Offset or keyset in prod? Comment which one."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part five."
  }
