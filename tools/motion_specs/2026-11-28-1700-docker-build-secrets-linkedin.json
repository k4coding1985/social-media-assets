 "voiceover": [
  {
   "id": "hook",
   "text": "Your Docker image is shipping your token."
  },
  {
   "id": "bug",
   "text": "You passed it as a build arg, or an ENV, to install private packages."
  },
  {
   "id": "why",
   "text": "Docker's own docs say build args and environment variables persist in the final image. Anyone who can pull it can go looking."
  },
  {
   "id": "fix",
   "text": "Use a BuildKit secret mount instead. The token is mounted as a file only for that run step, and it is not written into the image. Then rotate any token you already built in."
  },
  {
   "id": "bait",
   "text": "Build arg, or secret mount? Comment what your Dockerfiles use."
  },
  {
   "id": "follow",
   "text": "Follow me for one DevOps fix every day."
  }
 ],
