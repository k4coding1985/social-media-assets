 "voiceover": [
  {
   "id": "hook",
   "text": "Your retry just charged the customer twice."
  },
  {
   "id": "bug",
   "text": "The app sends a payment request. The server charges the card, but the response times out on the way back, so the app retries."
  },
  {
   "id": "why",
   "text": "The server cannot tell a retry from a new order. Every POST looks fresh, so the same payment runs again."
  },
  {
   "id": "fix",
   "text": "Send an idempotency key with each payment. The server stores it, and when the same key comes back, it returns the saved result instead of charging again."
  },
  {
   "id": "follow",
   "text": "Follow K four coding."
  }
 ],
