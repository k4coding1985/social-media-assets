 "voiceover": [
  {
   "id": "hook",
   "text": "Why did two customers buy the last item?"
  },
  {
   "id": "bug",
   "text": "Two requests read stock equals one at the same time. Both see one, both subtract, both write zero."
  },
  {
   "id": "why",
   "text": "Read, then write, is not atomic. The second update silently overwrites the first, so you sold two items but stock only dropped by one."
  },
  {
   "id": "fix",
   "text": "Do it in one statement. Update stock minus one where stock is greater than zero, and check the rows affected. Or lock the row with select for update."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part two."
  }
 ],
