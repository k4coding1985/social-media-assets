    "git {{add}} .",
    "git {{commit}} -m \"wip\""
   ]
  },
  {
   "id": "stamp",
   "type": "badge",
   "kind": "stamp",
   "text": "KEY LEAKED",
   "x": 540,
   "y": 680,
   "size": 44,
   "color": "red"
  },
  {
   "id": "ok",
   "type": "badge",
   "kind": "check",
   "x": 540,
   "y": 680,
   "r": 40,
   "color": "cyan"
  }
 ],
