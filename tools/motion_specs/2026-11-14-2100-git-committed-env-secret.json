{
 "slug": "git-committed-env-secret",
 "series": {
  "label": "Git Mistakes",
  "number": 2,
  "color": "orange"
 },
 "voice": {
  "name": "en-IN-NeerjaExpressiveNeural",
  "rate": "+5%",
  "pitch": "+0Hz"
 },
 "captions": {
  "enabled": true,
  "keywords": [
   ".env",
   "API key",
   "gitignore",
   "history",
   "rm --cached",
   "rotate"
  ],
  "keyword_color": "yellow",
  "max_chars": 30
 },
 "cover_at": "why@history+0.5",
 "chapters": [
  {
   "id": "hook",
   "text": "PUSHED YOUR {{SECRETS}}?",
   "color": "red"
  },
  {
   "id": "bug",
   "at": "bug:start",
   "text": "COMMITTED {{.ENV}}",
   "color": "yellow"
  },
  {
   "id": "why",
   "at": "why:start",
   "text": "{{HISTORY}} REMEMBERS",
   "color": "red"
  },
  {
   "id": "fix",
   "at": "fix:start",
   "text": "IGNORE AND {{ROTATE}}",
   "color": "purple"
  }
 ],
 "voiceover": [
  {
   "id": "hook",
   "text": "Did you just push your passwords?"
  },
  {
   "id": "bug",
   "text": "You ran git add dot and git commit. Your dot env file with the API key went straight into the repo and up to GitHub."
  },
  {
   "id": "why",
   "text": "Git tracks every file you stage. Deleting it in a later commit does not help, because the key still lives in history for anyone to read."
  },
  {
   "id": "fix",
   "text": "Add dot env to gitignore, run git rm dash dash cached dot env, and rotate the key right away."
  },
  {
   "id": "follow",
   "text": "Follow K four coding for part three."
  }
 ],
 "elements": [
  {
   "id": "la",
   "type": "line",
   "from": "local.bottom",
   "to": "hist.top-200",
   "start_visible": true
  },
  {
   "id": "lb",
   "type": "line",
   "from": "remote.bottom",
   "to": "hist.top+200",
   "start_visible": true
  },
  {
   "id": "local",
   "type": "window",
   "x": 290,
   "y": 480,
   "w": 480,
   "h": 200,
   "title": "LAPTOP",
   "icon": "laptop",
   "status": "cyan",
   "body": ".env {{KEY}}",
   "body_size": 50,
   "hl": "cyan",
   "start_visible": true
  },
  {
   "id": "remote",
   "type": "window",
   "x": 790,
   "y": 480,
   "w": 480,
   "h": 200,
   "title": "GITHUB",
   "icon": "cpu",
   "status": "cyan",
