 "voiceover": [
  {
   "id": "hook",
   "text": "Why does this loop print three, three, three?"
  },
  {
   "id": "bug",
   "text": "You loop with var i, and inside you set a timeout that logs i. You expect zero, one, two."
  },
  {
   "id": "why",
   "text": "But var is function scoped. All three callbacks share one i, and by the time the timers run, the loop has finished and i is three."
  },
  {
   "id": "fix",
   "text": "Use let instead. It creates a fresh binding for every iteration, so each callback keeps its own value, and you get zero, one, two."
  },
  {
   "id": "follow",
   "text": "Follow K four coding."
  }
 ],
