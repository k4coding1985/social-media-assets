{
  "slug": "n-plus-one-queries",
  "voice": {"name": "en-IN-NeerjaExpressiveNeural", "rate": "+5%", "pitch": "+0Hz"},
  "captions": {"enabled": true, "keywords": ["one loop", "one query", "hundred and one", "round trip", "timing out", "JOIN", "IN", "green"], "keyword_color": "yellow", "max_chars": 30},
  "cover_at": "why@timing+0.7",
  "chapters": [
    {"id": "hook", "text": "WHY IS MY API {{SLOW}}?", "color": "red"},
    {"id": "bug", "at": "bug:start", "text": "THE {{N+1}} QUERY BUG", "color": "yellow"},
    {"id": "why", "at": "why:start", "text": "{{DATABASE}} OVERLOADED", "color": "red"},
    {"id": "fix", "at": "fix:start", "text": "ONE {{JOIN}} QUERY", "color": "purple"}
  ],
  "voiceover": [
    {"id": "hook", "text": "Your API is slow because of one loop."},
    {"id": "bug", "text": "You fetch a hundred users, then run one query per user, inside the loop. That's a hundred and one queries for one page."},
    {"id": "why", "text": "Each query is a round trip to the database. The load climbs, connections pile up, and requests start timing out."},
    {"id": "fix", "text": "Fetch them together instead. One query with a JOIN, or WHERE user id IN a list. One round trip, and the load drops back to green."},
    {"id": "follow", "text": "Follow K four coding."}
  ],
  "elements": [
    {"id": "l1", "type": "line", "from": "api.top-240", "to": "db.bottom-240", "start_visible": true},
    {"id": "l2", "type": "line", "from": "api.top-80", "to": "db.bottom-80", "start_visible": true},
    {"id": "l3", "type": "line", "from": "api.top+80", "to": "db.bottom+80", "start_visible": true},
    {"id": "l4", "type": "line", "from": "api.top+240", "to": "db.bottom+240", "start_visible": true},
    {"id": "db", "type": "window", "x": 540, "y": 525, "w": 960, "h": 260, "title": "DATABASE", "icon": "database", "tag": "POSTGRES", "status": "cyan", "start_visible": true},
    {"id": "load", "type": "bar", "x": 540, "y": 605, "w": 880, "h": 52, "value": 0.12, "threshold": 0.7, "label": "DB load", "start_visible": true},
    {"id": "qcount", "type": "counter", "x": 980, "y": 548, "align": "right", "font": "mono", "weight": "Medium", "upper": false, "size": 44, "value": 4, "format": "{n} queries", "format_one": "{n} query", "color": "cyan", "start_visible": true},
    {"id": "api", "type": "window", "x": 540, "y": 920, "w": 760, "h": 190, "title": "API SERVER", "icon": "server", "tag": "NODE", "status": "cyan", "body": "GET /orders", "start_visible": true},
    {"id": "code", "type": "code", "x": 540, "y": 1225, "w": 900, "min_lines": 3, "title": "orders.js",
     "lines": ["users = db.query(\"users\")", "{{for}} (user {{of}} users)", "  db.query(user.id)"]},
    {"id": "timeout", "type": "badge", "kind": "stamp", "text": "TIMEOUT", "x": 540, "y": 740, "size": 44, "color": "red"},
    {"id": "ok", "type": "badge", "kind": "check", "x": 540, "y": 740, "r": 40, "color": "cyan"}
  ],
  "timeline": [
    {"at": 0.15, "do": "send", "path": ["l1", "l2", "l3", "l4"], "count": 4, "interval": 0.12, "dur": 0.7, "color": "cyan"},
    {"at": "hook@slow", "do": "shake", "target": "api", "dur": 0.5},
    {"at": "hook@slow", "do": "color", "target": "api:status", "color": "yellow", "dur": 0.3},
    {"at": "hook@loop-0.1", "do": "show", "target": "code", "anim": "slide_up", "dur": 0.45, "type_dur": 1.1},
    {"at": "bug@hundred", "do": "swap", "target": "api", "text": "GET /orders → {{100}} users"},
    {"at": "bug@query", "do": "pulse", "target": "code"},
    {"at": "bug@query", "do": "color", "target": "code:hl", "color": "yellow", "dur": 0.3},
    {"at": "bug@per", "do": "send", "path": ["l1", "l2", "l3", "l4"], "count": 26, "interval": 0.11, "dur": 0.6, "color": "cyan"},
    {"at": "bug@per", "do": "set", "target": "qcount", "value": 101, "dur": 3.2},
    {"at": "bug@per", "do": "set", "target": "load", "value": 0.58, "dur": 3.2},
    {"at": "bug@inside", "do": "color", "target": "code", "color": "red", "dur": 0.3},
    {"at": "bug@queries", "do": "pulse", "target": "qcount"},
    {"at": "bug@queries", "do": "color", "target": "qcount", "color": "red", "dur": 0.3},
    {"at": "why@round", "do": "send", "path": "l2", "count": 1, "dur": 0.45, "color": "cyan", "r": 11},
    {"at": "+0.45", "do": "send", "path": "l2", "reverse": true, "count": 1, "dur": 0.45, "color": "cyan", "r": 11},
    {"at": "why@database", "do": "pulse", "target": "db"},
    {"at": "why@database", "do": "send", "path": ["l1", "l3"], "count": 4, "interval": 0.15, "dur": 0.5, "color": "cyan"},
    {"at": "why@climbs", "do": "set", "target": "load", "value": 0.97, "dur": 1.3},
    {"at": "why@climbs", "do": "color", "target": ["db:status", "db"], "color": "red", "dur": 0.6, "sfx": "alert"},
    {"at": "why@pile", "do": "send", "path": ["l1", "l2", "l3", "l4"], "count": 18, "interval": 0.07, "dur": 0.5, "color": "bad"},
    {"at": "why@timing", "do": "show", "target": "timeout", "anim": "pop", "dur": 0.4, "sfx": "alert"},
    {"at": "why@timing", "do": "shake", "target": "api", "dur": 0.5},
    {"at": "why@timing", "do": "color", "target": ["api", "api:status"], "color": "red", "dur": 0.4},
    {"at": "fix@together", "do": "hide", "target": "timeout", "dur": 0.3},
    {"at": "fix@together", "do": "swap", "target": "code", "type_dur": 1.3,
     "lines": ["{{SELECT}} * {{FROM}} orders", "{{WHERE}} user_id {{IN}} (:ids)", "-- 1 query, 1 round trip"]},
    {"at": "fix@together", "do": "color", "target": ["code", "code:hl"], "color": "purple", "dur": 0.4},
    {"at": "fix@instead", "do": "pulse", "target": "code"},
    {"at": "fix@query", "do": "send", "path": "l3", "count": 1, "dur": 0.6, "color": "purple", "r": 12},
    {"at": "fix@JOIN", "do": "pulse", "target": "code"},
    {"at": "fix@JOIN", "do": "swap", "target": "api", "text": "GET /orders → {{1}} query"},
    {"at": "fix@list", "do": "set", "target": "qcount", "value": 1, "dur": 0.8},
    {"at": "fix@list", "do": "color", "target": "qcount", "color": "cyan", "dur": 0.4},
    {"at": "fix@trip", "do": "send", "path": "l2", "count": 1, "dur": 0.6, "color": "cyan", "r": 14},
    {"at": "fix@drops", "do": "set", "target": "load", "value": 0.16, "dur": 1.0},
    {"at": "fix@drops", "do": "color", "target": ["db", "api"], "color": "panel", "dur": 0.5},
    {"at": "fix@drops", "do": "color", "target": ["db:status", "api:status"], "color": "cyan", "dur": 0.5},
    {"at": "fix@green", "do": "show", "target": "ok", "anim": "pop", "dur": 0.4, "sfx": "ding"}
  ],
  "end_card": {"segment": "follow", "line1": "FOLLOW", "line2": "{{@K4CODING}}", "line3": "one concept, one diagram, daily"},
  "variants": {
    "facebook": {
      "chapters": {
        "hook": {"text": "{{101 QUERIES}} PER PAGE?", "color": "red"},
        "why": {"text": "DB {{DROWNING}}", "color": "red"}
      },
      "cover_at": "bug@queries+0.8"
    }
  }
}
