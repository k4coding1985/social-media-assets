 "voiceover": [
  {
   "id": "hook",
   "text": "Your query is slow because of a missing index."
  },
  {
   "id": "bug",
   "text": "You search orders by email, but email has no index. So the database reads every single row, all two million of them, to find one."
  },
  {
   "id": "why",
   "text": "That's a full table scan. Each request scans the whole table, the disk gets busy, the load climbs, and requests start timing out."
  },
  {
   "id": "fix",
   "text": "Add an index. CREATE INDEX on orders email. Now the database jumps straight to the matching row, and the load drops back to green."
  },
  {
   "id": "follow",
   "text": "Follow K four coding."
  }
 ],
