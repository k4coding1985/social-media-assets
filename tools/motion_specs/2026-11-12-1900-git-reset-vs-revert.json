{
 "slug": "git-reset-vs-revert",
 "voice": {"name": "en-IN-NeerjaExpressiveNeural", "rate": "+5%", "pitch": "+0Hz"},
 "captions": {"enabled": true, "keywords": ["pushed commit", "reset hard", "force pushed", "rewrites history", "conflicts", "git revert", "new commit", "normal push"], "keyword_color": "yellow", "max_chars": 30},
 "cover_at": "why@rewrites+0.5",
 "chapters": [
  {"id": "hook", "text": "{{GIT RESET}} FAIL", "color": "red"},
  {"id": "bug", "at": "bug:start", "text": "{{RESET}} + FORCE", "color": "yellow"},
  {"id": "why", "at": "why:start", "text": "{{HISTORY}} REWRITTEN", "color": "red"},
  {"id": "fix", "at": "fix:start", "text": "USE {{GIT REVERT}}", "color": "purple"}
 ],
 "voiceover": [
  {"id": "hook", "text": "Undo a pushed commit the wrong way and you break everyone's branch."},
  {"id": "bug", "text": "A bad commit reached main. You ran git reset hard, then force pushed to remove it."},
  {"id": "why", "text": "Reset rewrites history. Your teammates still have that commit, so their next pull conflicts and the bad code can come right back."},
  {"id": "fix", "text": "On a shared branch, use git revert instead. It adds a new commit that undoes the change, so history stays intact and a normal push works."},
  {"id": "follow", "text": "Follow K four coding."}
 ],
 "elements": [
  {"id": "l1", "type": "line", "from": "local.top-240", "to": "remote.bottom-240", "start_visible": true},
  {"id": "l2", "type": "line", "from": "local.top-80", "to": "remote.bottom-80", "start_visible": true},
  {"id": "l3", "type": "line", "from": "local.top+80", "to": "remote.bottom+80", "start_visible": true},
  {"id": "l4", "type": "line", "from": "local.top+240", "to": "remote.bottom+240", "start_visible": true},
  {"id": "remote", "type": "window", "x": 540, "y": 525, "w": 960, "h": 260, "title": "MAIN", "icon": "globe", "tag": "REMOTE", "status": "cyan", "body": "A - B - {{BAD}}", "body_size": 56, "hl": "red", "start_visible": true},
  {"id": "local", "type": "window", "x": 540, "y": 920, "w": 760, "h": 190, "title": "TEAMMATE", "icon": "laptop", "tag": "LOCAL", "status": "cyan", "body": "A - B - {{BAD}}", "body_size": 56, "start_visible": true},
  {"id": "code", "type": "code", "x": 540, "y": 1225, "w": 900, "min_lines": 3, "title": "terminal", "lines": ["git reset {{--hard}} HEAD~1", "git push --force", "# history rewritten"]},
  {"id": "conf", "type": "badge", "kind": "stamp", "text": "CONFLICT", "x": 540, "y": 740, "size": 44, "color": "red"},
  {"id": "ok", "type": "badge", "kind": "check", "x": 540, "y": 740, "r": 40, "color": "cyan"}
 ],
